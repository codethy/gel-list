// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── AUTH ───────────────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── USER ───────────────────────────────────────────────────────────────────

model User {
  checklistCardLikes ChecklistCardLike[]
  id                 String              @id @default(cuid())
  name               String?
  email              String?             @unique
  emailVerified      DateTime?
  image              String?

  username            String?   @unique
  profileImage        String?
  usernameLastChanged DateTime?

  // Auto-generated the first time a user signs in (see events.createUser in
  // app/api/auth/[...nextauth]/route.ts) — 5 lowercase-alphanumeric characters,
  // unique, shown only to the user themself under their name. Distinct from
  // `username` above, which is a different, unrelated display-name fallback
  // used for gel attribution.
  handle String? @unique

  // False right after first sign-in — Google supplies an initial `name`, but
  // every new user is required to pick their own display name via a blocking
  // pop-up (see components/NameSetupModal.tsx) before using the app. This
  // flips to true once they submit that form; names don't need to be unique,
  // since `handle` already disambiguates users with the same name.
  hasCustomName Boolean @default(false)

  // Developer-only access to /admin/gels — set by hand via prisma/make-admin.ts,
  // there is no in-app way to grant this.
  isAdmin Boolean @default(false)

  // Once a user has had 5 of their logged gels verified by the developer,
  // every gel they log afterward is auto-verified instead of entering the
  // review queue — see app/api/sets/[id]/gels/route.ts.
  isVerifiedUser Boolean @default(false)

  // Remembered from this user's own most recent "Log a Gel" submission
  // (loggedFor "SELF" only) — pre-fills the City/Country fields the next
  // time they log a gel, since these rarely change between submissions.
  // Only updated when a submission actually provides a non-empty value —
  // see lib/data/userGelDefaults.ts.
  lastGelCity    String?
  lastGelCountry String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts          Account[]
  sessions          Session[]
  portfolioCards    PortfolioCard[]
  ripSessions       RipSession[]
  unverifiedHits    UnverifiedHit[]
  // ✅ NEW: needed for Chain of Custody — tracks cards transferred to this user
  receivedTransfers CardTransfer[]  @relation("TransferReceiver")
  // ✅ NEW: needed for Chain of Custody — tracks cards transferred from this user
  sentTransfers     CardTransfer[]  @relation("TransferSender")
  favoriteGels      FavoriteGel[]
  productOpenings   ProductOpening[]
}

// ─── TAXONOMY ───────────────────────────────────────────────────────────────

enum Category {
  SPORTS
  TCG
  ENTERTAINMENT
}

enum SportSubCategory {
  SOCCER
  BASKETBALL
  BASEBALL
  FOOTBALL
  TENNIS
  RACING
  HOCKEY
  GOLF
  UFC_MMA
  OTHER
}

enum TcgSubCategory {
  POKEMON
  ONE_PIECE
  MAGIC_THE_GATHERING
  YU_GI_OH
  LORCANA
  RIFTBOUND
  OTHER
}

enum EntertainmentSubCategory {
  DISNEY
  MARVEL
  STAR_WARS
  DC
  HARRY_POTTER
  FORTNITE
  OTHER
}

// Tracks how a logged gel came to be known about.
// PULLED/BOUGHT: the logging user's own gel — how they personally got it.
// BREAKER/EBAY/FRIEND/SOCIAL_MEDIA/OTHER: someone else's gel — where the
// logging user saw it surface (PortfolioCard.isInHand is false for these).
enum AcquisitionMethod {
  PULLED
  BOUGHT
  BREAKER
  EBAY
  FRIEND
  SOCIAL_MEDIA
  OTHER
}

// ─── CARD SET ───────────────────────────────────────────────────────────────

model CardSet {
  id          String   @id @default(cuid())
  name        String
  year        Int
  brand       String
  category    Category
  subCategory String

  totalCardsInSet      Int @default(0)
  totalHitsInSet       Int @default(0)
  // ✅ NEW: required for "Chase Cards" bubble on Sports/Entertainment sets
  totalChaseCardsInSet Int @default(0)

  imageUrl    String?
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  checklistCards   ChecklistCard[]
  portfolioCards   PortfolioCard[]
  ripSessions      RipSession[]
  products         SetProduct[]
  featuredOn       HomepageFeaturedSet[]
  productOpenings  ProductOpening[]
}

// Admin-curated selection of sets shown on the home page for each category
// (up to HomepageFeaturedSet.MAX_PER_CATEGORY — see lib/data/homepage.ts).
// Replaces just showing whatever sets happen to sort first; managed from
// /admin/homepage.
model HomepageFeaturedSet {
  id        String   @id @default(cuid())
  category  Category
  cardSetId String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  cardSet CardSet @relation(fields: [cardSetId], references: [id], onDelete: Cascade)

  @@unique([category, cardSetId])
  @@index([category, order])
}

// ─── CARD TAXONOMY (CardCategory / CardTier) ─────────────────────────────────
// ChecklistCard (below) is the single canonical "card catalog" table for a
// set. The CardTemplate model that used to sit alongside it has been removed
// so there is only one place that represents "a card that exists in a set."

// ─────────────────────────────────────────────────────────────────────────────
// CardCategory — What type of card this is
//
// Sports & Entertainment:
//   BASE, PARALLEL, INSERT, AUTO, RELIC, AUTO_RELIC, PATCH_AUTO,
//   FACSIMILE_AUTO, DUAL_AUTO, TRIPLE_AUTO, QUAD_AUTO, BOOKLET,
//   ON_CARD_AUTO, IMAGE_VARIATION, SKETCH_ART, SHORT_PRINT,
//   SUPER_SHORT_PRINT, CASE_HIT, PROMO
//
// TCG:
//   REGULAR, HOLO, REVERSE_HOLO, SHADOWLESS, COLD_FOIL, HOLO_FOIL,
//   FULL_ART, ALT_ART, OTHER_FOIL, TCG_PROMO
// ─────────────────────────────────────────────────────────────────────────────
enum CardCategory {
  // ── Sports & Entertainment ──────────────────────────────────────────────
  BASE
  PARALLEL
  INSERT
  AUTO
  RELIC
  AUTO_RELIC
  PATCH_AUTO
  FACSIMILE_AUTO
  DUAL_AUTO
  TRIPLE_AUTO
  QUAD_AUTO
  BOOKLET
  ON_CARD_AUTO
  IMAGE_VARIATION
  SKETCH_ART
  SHORT_PRINT
  SUPER_SHORT_PRINT
  CASE_HIT
  PROMO

  // ── TCG ─────────────────────────────────────────────────────────────────
  REGULAR
  HOLO
  REVERSE_HOLO
  SHADOWLESS
  COLD_FOIL
  HOLO_FOIL
  FULL_ART
  ALT_ART
  OTHER_FOIL
  TCG_PROMO
}

// ─────────────────────────────────────────────────────────────────────────────
// CardTier — The rarity / print run tier of the card
//
// Universal tiers (Sports, Entertainment & TCG):
//   UNLIMITED, LIMITED, NUMBERED, ONE_OF_ONE, SP, SSP, CASE_HIT
//
// TCG rarity tiers:
//   COMMON, UNCOMMON, RARE, RR, SR, AR, SAR, UR, MUR, ACE, SHR, SSR,
//   SUPER_RARE, LEGENDARY, EPIC, ENCHANTED, ICONIC, ALT_ART,
//   OVER, OVER_SIGN, MYTHIC,
//   C_ALT, UC_ALT, R_ALT, SR_ALT, SR_MANGA,
//   SEC, SEC_ALT, LEADER, L_ALT,
//   SPECIAL_RARE, MANGA, GOLD_MANGA, TR, DON, GOLD_DON,
//   ULTIMATE_RARE, GHOST_RARE, PROMO
// ─────────────────────────────────────────────────────────────────────────────
enum CardTier {
  // ── Universal ───────────────────────────────────────────────────────────
  UNLIMITED
  LIMITED
  NUMBERED
  ONE_OF_ONE
  SP // Short Print
  SSP // Super Short Print
  CASE_HIT

  // ── TCG Rarity Tiers ────────────────────────────────────────────────────
  COMMON
  UNCOMMON
  RARE
  RR // Double Rare
  SR // Ultra Rare
  AR // Illustration Rare
  SAR // Special Illustration Rare
  UR // Hyper Rare
  MUR // Mega Hyper Rare
  ACE // ACE Spec Rare
  SHR // Shiny Rare
  SSR // Shiny Ultra Rare
  SUPER_RARE
  LEGENDARY
  EPIC
  ENCHANTED
  ICONIC
  ALT_ART
  OVER // Overnumbered
  OVER_SIGN // Overnumbered Signature
  MYTHIC
  C_ALT // Common Alt Art
  UC_ALT // Uncommon Alt Art
  R_ALT // Rare Alt Art
  SR_ALT // Super Rare Alt Art
  SR_MANGA // Super Rare Manga
  SEC // Secret Rare
  SEC_ALT // Secret Rare Alt Art
  LEADER
  L_ALT // Leader Alt Art
  SPECIAL_RARE
  MANGA
  GOLD_MANGA // Golden Manga Rare
  TR // Treasure Rare
  DON
  GOLD_DON // Golden DON
  ULTIMATE_RARE
  GHOST_RARE
  PROMO
}

// ─── PRODUCT TYPES ──────────────────────────────────────────────────────────

enum ProductType {
  HOBBY_BOX
  HOBBY_PACK
  BLASTER_BOX
  BLASTER_PACK
  JUMBO_BOX
  MEGA_BOX
  BREAKERS_DELIGHT_BOX
  HANGER_BOX
  HANGER_PACK
  BOOSTER_PACK
  CASE
  ETB
  BOOSTER_BUNDLE
  UPC
  SPC
  BOOSTER_BOX
  TROVE
  FDI
  FANATICS_FEST
  HONG_BAO_BOX
  LOGOFRACTOR
  OTHER
}

// ─── SET PRODUCT ──────────────────────────────────────────────────────────────
// The admin-curated catalog of products (Hobby Box, Jumbo Box, etc.) a
// given set was actually released in — managed per set on the
// /admin/sets/[id]/checklist page, empty by default. This is what powers
// the "Which Product" dropdown in the Log a Gel form (only enabled when
// "How did you get it?" is "Pulled"), rather than every set sharing one
// global list — a Case is only ever an option for sets that actually sold
// one.
model SetProduct {
  id               String      @id @default(cuid())
  cardSetId        String
  productType      ProductType
  productTypeOther String? // only meaningful when productType is OTHER
  createdAt        DateTime    @default(now())

  cardSet   CardSet           @relation(fields: [cardSetId], references: [id], onDelete: Cascade)
  packKinds ProductPackKind[]
  openings  ProductOpening[]

  @@index([cardSetId])
}

// One "kind" of pack bundled inside a unit of a SetProduct — most products
// only ever need one (e.g. a Hobby Box holding 24 identical packs), but
// some mix different pack types in one box (e.g. 20 base packs of 8 cards
// + 4 bonus packs of 4 cards). packsCount is how many packs of this kind
// come in a single unit of the product; summed across every kind, that's
// the product's total packs-per-unit — see lib/data/productOpenings.ts.
model ProductPackKind {
  id           String @id @default(cuid())
  setProductId String
  packsCount   Int
  cardsPerPack Int
  sortOrder    Int    @default(0)

  setProduct SetProduct @relation(fields: [setProductId], references: [id], onDelete: Cascade)

  @@index([setProductId])
}

// One user's logged "I opened N of this product" count for a set — an
// aggregate quantity, not an individual gel — powering the set page's
// "X Packs/Boxes Opened" total and its per-product breakdown (see
// lib/data/productOpenings.ts). isBreak flags whether this was opened as
// a breaker (vs. for the user's own personal collection), kept as its own
// column — rather than inferred from productType alone — so a future
// "hits pulled by breakers" report can filter on it directly across every
// product type, not just BREAKERS_DELIGHT_BOX.
model ProductOpening {
  id           String   @id @default(cuid())
  userId       String
  cardSetId    String
  setProductId String
  quantity     Int
  isBreak      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardSet    CardSet    @relation(fields: [cardSetId], references: [id], onDelete: Cascade)
  setProduct SetProduct @relation(fields: [setProductId], references: [id], onDelete: Cascade)

  @@unique([userId, setProductId])
  @@index([cardSetId])
}

enum PurchaseChannel {
  OFFICIAL_WEBSITE
  EBAY
  LOCAL_STORE
  BREAKERS
  OTHER
}

enum LocalStore {
  WALMART
  TARGET
  COSTCO
  BESTBUY
  OTHER
}

enum BreakerPlatform {
  WHATNOT
  FANATICS
  EBAY_LIVE
  OTHER
}

// ─── PORTFOLIO CARD ──────────────────────────────────────────────────────────

model PortfolioCard {
  id              String  @id @default(cuid())
  userId          String
  checklistCardId String
  cardSetId       String
  ripSessionId    String?

  isHit    Boolean @default(false)
  isInHand Boolean @default(true)

  // ✅ NEW: Pulled or Bought — required by "Your Card" modal path
  acquisitionMethod AcquisitionMethod?

  // Hit context
  hitCountry String?
  hitCity    String?
  hitMonth   Int?
  hitYear    Int?

  // ✅ NEW: Seller field — required by "Your Card" modal path
  seller String? @db.VarChar(255)

  // Product info
  productType           ProductType?
  productTypeOther      String?      @db.VarChar(150)
  totalCardsInProduct   Int?
  productQuantityOpened Int?

  // Purchase channel
  purchaseChannel      PurchaseChannel?
  localStore           LocalStore?
  localStoreOther      String?          @db.VarChar(150)
  breakerPlatform      BreakerPlatform?
  breakerOther         String?          @db.VarChar(150)
  purchaseChannelOther String?          @db.VarChar(150)

  // Serial number
  serialNumber Int?

  // ✅ UPDATED: split into front and back images (was single cardImageUrl)
  cardFrontImageUrl String?
  cardBackImageUrl  String?

  notes String? @db.Text

  isDuplicate Boolean @default(false)

  // Every logged gel starts unverified and sits in the developer's /admin/gels
  // review queue — see app/api/admin/gels/[gelId]/verify/route.ts — unless the
  // logging user has already crossed the 5-verified-gels threshold
  // (User.isVerifiedUser), in which case it's auto-verified at creation time.
  isVerified Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  checklistCard ChecklistCard  @relation(fields: [checklistCardId], references: [id])
  cardSet       CardSet        @relation(fields: [cardSetId], references: [id])
  ripSession    RipSession?    @relation(fields: [ripSessionId], references: [id])
  // ✅ NEW: chain of custody transfers originating from this portfolio entry
  transfers     CardTransfer[]
  favoritedBy   FavoriteGel[]
}

// ─── FAVORITE GEL ─────────────────────────────────────────────────────────────
// A user's hand-picked "Favorite Gels" shown on their profile page (max 6,
// enforced in app/api/profile/favorites/route.ts, not here) — `order`
// drives the display sequence, which the user can rearrange.
model FavoriteGel {
  id              String   @id @default(cuid())
  userId          String
  portfolioCardId String
  order           Int      @default(0)
  createdAt       DateTime @default(now())

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  portfolioCard PortfolioCard @relation(fields: [portfolioCardId], references: [id], onDelete: Cascade)

  @@unique([userId, portfolioCardId])
  @@index([userId, order])
}

// ─── RIP SESSION ────────────────────────────────────────────────────────────

model RipSession {
  id        String  @id @default(cuid())
  userId    String
  cardSetId String?

  productType      ProductType
  productTypeOther String?     @db.VarChar(150)
  quantity         Int         @default(1)

  totalCardsFromSession Int @default(0)
  totalHitsFromSession  Int @default(0)

  finishedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardSet        CardSet?        @relation(fields: [cardSetId], references: [id])
  portfolioCards PortfolioCard[]
}

// ─── UNVERIFIED HIT ──────────────────────────────────────────────────────────

model UnverifiedHit {
  id              String @id @default(cuid())
  checklistCardId String
  submittedById   String

  // ✅ UPDATED: notes and sightings are now REQUIRED (not optional)
  notes     String @db.Text
  sightings String @db.Text

  // ✅ NEW: optional provenance fields for "Not Your Card" path
  reportedUsername  String?
  sourceUrl         String?
  acquisitionMethod AcquisitionMethod?
  seller            String?            @db.VarChar(255)
  hitCountry        String?
  hitCity           String?
  hitMonth          Int?
  hitYear           Int?
  productType       ProductType?

  // ✅ NEW: optional front/back images for "Not Your Card" path
  cardFrontImageUrl String?
  cardBackImageUrl  String?

  createdAt DateTime @default(now())

  checklistCard ChecklistCard @relation(fields: [checklistCardId], references: [id])
  submittedBy   User          @relation(fields: [submittedById], references: [id])
}

// ─── CARD TRANSFER (Chain of Custody) ────────────────────────────────────────
// ✅ NEW MODEL: tracks the full movement history of a physical card

model CardTransfer {
  id              String @id @default(cuid())
  checklistCardId String
  portfolioCardId String

  // Who sent and who received
  fromUserId String? // null = external/unknown origin
  toUserId   String? // null = sold outside the platform

  // Transfer context
  transferDate   DateTime?
  transferMethod String?   @db.VarChar(100) // e.g. "Sold", "Traded", "Gifted"
  salePrice      Float?
  notes          String?   @db.Text

  createdAt DateTime @default(now())

  checklistCard ChecklistCard @relation(fields: [checklistCardId], references: [id])
  portfolioCard PortfolioCard @relation(fields: [portfolioCardId], references: [id])
  fromUser      User?         @relation("TransferSender", fields: [fromUserId], references: [id])
  toUser        User?         @relation("TransferReceiver", fields: [toUserId], references: [id])
}

// ─── CHECKLIST CARD LIKE ─────────────────────────────────────────────────────

model ChecklistCardLike {
  id              String   @id @default(cuid())
  userId          String
  checklistCardId String
  createdAt       DateTime @default(now())

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  checklistCard ChecklistCard @relation(fields: [checklistCardId], references: [id], onDelete: Cascade)

  @@unique([userId, checklistCardId])
}

// ─── CHECKLIST CARD ──────────────────────────────────────────────────────────
// Represents a single card entry in an official set checklist.
// This is the "master list" of every card that exists in a given CardSet.

model ChecklistCard {
  id        String @id @default(cuid())
  cardSetId String

  cardNumber String
  playerName String // For TCG: card name e.g. "Charizard ex"
  team       String? // Sports/Entertainment only — null for TCG

  // ── The 3-Layer Identity ─────────────────────────────────────────────────
  cardCategory CardCategory // What family: AUTO, PARALLEL, HYPER_RARE, etc.
  cardTier     CardTier // How scarce: NUMBERED, ONE_OF_ONE, SSP, etc.

  // ── Card-Specific Attributes ─────────────────────────────────────────────
  parallel      String? // e.g. "Black", "Gold", "Red", "Orange" — null for base
  printRun      Int? // e.g. 10, 5, 25, 99 — null if unlimited/unspecified
  variationName String? // e.g. "Planetary Pursuit Sun", "Trophy Supercollector"

  // ── Quick-Access Flags ───────────────────────────────────────────────────
  // isChase was removed: every checklist row imported onto this platform is
  // intentionally a chase card already (base cards are excluded from the
  // source checklist before import), so the flag carried no information.
  isHit Boolean @default(false) // AUTO, RELIC, AUTO_RELIC, etc.

  // Admin-set default image for this checklist row, uploaded per card from
  // /admin/sets/[id]/checklist — shown until a real user logs a gel against
  // this card, whose own photo then takes precedence (see
  // lib/data/checklistRowExtras.ts and lib/data/sets.ts for the fallback).
  imageUrl String?

  // Admin-only notes shown in the public checklist's "Notes" column — set
  // from the Edit Checklist Card flow at /admin/sets/[id]/checklist. Not to
  // be confused with PortfolioCard.notes (a user's own note about their
  // logged gel, which only ever appears in that gel's own Card History).
  notes String? @db.Text

  // Position of this card in the original checklist file (0 = first row).
  // The checklist page always displays cards ordered by this field, so it
  // matches the sequence the set's source file was published in, rather
  // than an alphabetical re-sort. Set at import time — see
  // prisma/import-checklist.ts.
  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cardSet        CardSet             @relation(fields: [cardSetId], references: [id], onDelete: Cascade)
  portfolioCards PortfolioCard[]
  likes          ChecklistCardLike[]
  transfers      CardTransfer[]
  unverifiedHits UnverifiedHit[]

  @@unique([cardSetId, cardNumber, parallel])
  @@index([cardSetId, sortOrder])
}
