// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── AUTH ───────────────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── USER ───────────────────────────────────────────────────────────────────

model User {
  checklistCardLikes ChecklistCardLike[]
  id                 String              @id @default(cuid())
  name               String?
  email              String?             @unique
  emailVerified      DateTime?
  image              String?

  username            String?   @unique
  profileImage        String?
  usernameLastChanged DateTime?

  // Auto-generated the first time a user signs in (see events.createUser in
  // app/api/auth/[...nextauth]/route.ts) — 5 lowercase-alphanumeric characters,
  // unique, shown only to the user themself under their name. Distinct from
  // `username` above, which is a different, unrelated display-name fallback
  // used for gel attribution.
  handle String? @unique

  // A short, free-text intro and/or social handles — shown on the profile
  // page right under @handle. Up to 3 newline-separated lines, enforced
  // both client-side (ProfileAccountCard.tsx) and server-side
  // (app/api/user/bio/route.ts).
  bio String? @db.VarChar(300)

  // False right after first sign-in — Google supplies an initial `name`, but
  // every new user is required to pick their own display name via a blocking
  // pop-up (see components/NameSetupModal.tsx) before using the app. This
  // flips to true once they submit that form; names don't need to be unique,
  // since `handle` already disambiguates users with the same name.
  hasCustomName Boolean @default(false)

  // Developer-only access to /admin/gels — set by hand via prisma/make-admin.ts,
  // there is no in-app way to grant this.
  isAdmin Boolean @default(false)

  // Once a user has had 5 of their logged gels verified by the developer,
  // every gel they log afterward is auto-verified instead of entering the
  // review queue — see app/api/sets/[id]/gels/route.ts.
  isVerifiedUser Boolean @default(false)

  // Remembered from this user's own most recent "Log a Gel" submission
  // (loggedFor "SELF" only) — pre-fills the City/Country fields the next
  // time they log a gel, since these rarely change between submissions.
  // Only updated when a submission actually provides a non-empty value —
  // see lib/data/userGelDefaults.ts.
  lastGelCity    String?
  lastGelCountry String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts            Account[]
  sessions            Session[]
  portfolioCards      PortfolioCard[]
  ripSessions         RipSession[]
  unverifiedHits      UnverifiedHit[]
  // ✅ NEW: needed for Chain of Custody — tracks cards transferred to this user
  receivedTransfers   CardTransfer[]     @relation("TransferReceiver")
  // ✅ NEW: needed for Chain of Custody — tracks cards transferred from this user
  sentTransfers       CardTransfer[]     @relation("TransferSender")
  favoriteGels        FavoriteGel[]
  yourGelsPins        YourGelsPin[]
  productOpenings     ProductOpening[]
  filedDuplicateFiles DuplicateGelFile[] @relation("DuplicateFiledBy")
  notifications       Notification[]
}

// ─── TAXONOMY ───────────────────────────────────────────────────────────────

enum Category {
  SPORTS
  TCG
  ENTERTAINMENT
}

enum SportSubCategory {
  SOCCER
  BASKETBALL
  BASEBALL
  FOOTBALL
  TENNIS
  RACING
  HOCKEY
  GOLF
  UFC_MMA
  OTHER
}

enum TcgSubCategory {
  POKEMON
  ONE_PIECE
  MAGIC_THE_GATHERING
  YU_GI_OH
  LORCANA
  RIFTBOUND
  OTHER
}

enum EntertainmentSubCategory {
  DISNEY
  MARVEL
  STAR_WARS
  DC
  HARRY_POTTER
  FORTNITE
  OTHER
}

// Tracks how a logged gel came to be known about.
// PULLED/BOUGHT: the logging user's own gel — how they personally got it.
// BREAKER/EBAY/FRIEND/SOCIAL_MEDIA/OTHER: someone else's gel — where the
// logging user saw it surface (PortfolioCard.isInHand is false for these).
enum AcquisitionMethod {
  PULLED
  BOUGHT
  BREAKER
  EBAY
  FRIEND
  SOCIAL_MEDIA
  INFLUENCER
  OTHER
}

// ─── CARD SET ───────────────────────────────────────────────────────────────

model CardSet {
  id          String   @id @default(cuid())
  name        String
  year        Int
  brand       String
  category    Category
  subCategory String

  totalCardsInSet      Int @default(0)
  totalHitsInSet       Int @default(0)
  // ✅ NEW: required for "Chase Cards" bubble on Sports/Entertainment sets
  totalChaseCardsInSet Int @default(0)

  imageUrl    String?
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  checklistCards  ChecklistCard[]
  portfolioCards  PortfolioCard[]
  ripSessions     RipSession[]
  products        SetProduct[]
  featuredOn      HomepageFeaturedSet[]
  productOpenings ProductOpening[]
  yourGelsPins    YourGelsPin[]
}

// Admin-curated selection of sets shown on the home page for each category
// (up to HomepageFeaturedSet.MAX_PER_CATEGORY — see lib/data/homepage.ts).
// Replaces just showing whatever sets happen to sort first; managed from
// /admin/homepage.
model HomepageFeaturedSet {
  id        String   @id @default(cuid())
  category  Category
  cardSetId String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  cardSet CardSet @relation(fields: [cardSetId], references: [id], onDelete: Cascade)

  @@unique([category, cardSetId])
  @@index([category, order])
}

// ─── CARD TAXONOMY (CardCategory / CardTier) ─────────────────────────────────
// ChecklistCard (below) is the single canonical "card catalog" table for a
// set. The CardTemplate model that used to sit alongside it has been removed
// so there is only one place that represents "a card that exists in a set."

// ─────────────────────────────────────────────────────────────────────────────
// CardCategory — What type of card this is
//
// Sports & Entertainment:
//   BASE, PARALLEL, INSERT, AUTO, RELIC, AUTO_RELIC, PATCH_AUTO,
//   FACSIMILE_AUTO, DUAL_AUTO, TRIPLE_AUTO, QUAD_AUTO, BOOKLET,
//   ON_CARD_AUTO, IMAGE_VARIATION, SKETCH_ART, SHORT_PRINT,
//   SUPER_SHORT_PRINT, CASE_HIT, PROMO
//
// TCG:
//   REGULAR, HOLO, REVERSE_HOLO, SHADOWLESS, COLD_FOIL, HOLO_FOIL,
//   FULL_ART, ALT_ART, OTHER_FOIL, TCG_PROMO
// ─────────────────────────────────────────────────────────────────────────────
enum CardCategory {
  // ── Sports & Entertainment ──────────────────────────────────────────────
  BASE
  PARALLEL
  INSERT
  AUTO
  RELIC
  AUTO_RELIC
  PATCH_AUTO
  FACSIMILE_AUTO
  DUAL_AUTO
  TRIPLE_AUTO
  QUAD_AUTO
  BOOKLET
  ON_CARD_AUTO
  IMAGE_VARIATION
  SKETCH_ART
  SHORT_PRINT
  SUPER_SHORT_PRINT
  CASE_HIT
  PROMO

  // ── TCG ─────────────────────────────────────────────────────────────────
  REGULAR
  HOLO
  REVERSE_HOLO
  SHADOWLESS
  COLD_FOIL
  HOLO_FOIL
  FULL_ART
  ALT_ART
  OTHER_FOIL
  TCG_PROMO
}

// ─────────────────────────────────────────────────────────────────────────────
// CardTier — The rarity / print run tier of the card
//
// Universal tiers (Sports, Entertainment & TCG):
//   UNLIMITED, LIMITED, NUMBERED, ONE_OF_ONE, SP, SSP, CASE_HIT
//
// TCG rarity tiers:
//   COMMON, UNCOMMON, RARE, RR, SR, AR, SAR, UR, MUR, ACE, SHR, SSR,
//   SUPER_RARE, LEGENDARY, EPIC, ENCHANTED, ICONIC, ALT_ART,
//   OVER, OVER_SIGN, MYTHIC,
//   C_ALT, UC_ALT, R_ALT, SR_ALT, SR_MANGA,
//   SEC, SEC_ALT, LEADER, L_ALT,
//   SPECIAL_RARE, MANGA, GOLD_MANGA, TR, DON, GOLD_DON,
//   ULTIMATE_RARE, GHOST_RARE, PROMO
// ─────────────────────────────────────────────────────────────────────────────
enum CardTier {
  // ── Universal ───────────────────────────────────────────────────────────
  UNLIMITED
  LIMITED
  NUMBERED
  ONE_OF_ONE
  SP // Short Print
  SSP // Super Short Print
  CASE_HIT

  // ── TCG Rarity Tiers ────────────────────────────────────────────────────
  COMMON
  UNCOMMON
  RARE
  RR // Double Rare
  SR // Ultra Rare
  AR // Illustration Rare
  SAR // Special Illustration Rare
  UR // Hyper Rare
  MUR // Mega Hyper Rare
  ACE // ACE Spec Rare
  SHR // Shiny Rare
  SSR // Shiny Ultra Rare
  SUPER_RARE
  LEGENDARY
  EPIC
  ENCHANTED
  ICONIC
  ALT_ART
  OVER // Overnumbered
  OVER_SIGN // Overnumbered Signature
  MYTHIC
  C_ALT // Common Alt Art
  UC_ALT // Uncommon Alt Art
  R_ALT // Rare Alt Art
  SR_ALT // Super Rare Alt Art
  SR_MANGA // Super Rare Manga
  SEC // Secret Rare
  SEC_ALT // Secret Rare Alt Art
  LEADER
  L_ALT // Leader Alt Art
  SPECIAL_RARE
  MANGA
  GOLD_MANGA // Golden Manga Rare
  TR // Treasure Rare
  DON
  GOLD_DON // Golden DON
  ULTIMATE_RARE
  GHOST_RARE
  PROMO
}

// ─── PRODUCT TYPES ──────────────────────────────────────────────────────────

enum ProductType {
  HOBBY_BOX
  HOBBY_PACK
  BLASTER_BOX
  BLASTER_PACK
  JUMBO_BOX
  MEGA_BOX
  BREAKERS_DELIGHT_BOX
  HANGER_BOX
  HANGER_PACK
  BOOSTER_PACK
  CASE
  ETB
  BOOSTER_BUNDLE
  UPC
  SPC
  BOOSTER_BOX
  TROVE
  FDI
  FANATICS_FEST
  HONG_BAO_BOX
  LOGOFRACTOR
  PRE_RIFT_KIT
  VAULT
  SHOWDOWN_DECK
  SLEEVED_PACK
  OTHER
}

// ─── SET PRODUCT ──────────────────────────────────────────────────────────────
// The admin-curated catalog of products (Hobby Box, Jumbo Box, etc.) a
// given set was actually released in — managed per set on the
// /admin/sets/[id]/checklist page, empty by default. This is what powers
// the "Which Product" dropdown in the Log a Gel form (only enabled when
// "How did you get it?" is "Pulled"), rather than every set sharing one
// global list — a Case is only ever an option for sets that actually sold
// one.
model SetProduct {
  id               String      @id @default(cuid())
  cardSetId        String
  productType      ProductType
  productTypeOther String? // only meaningful when productType is OTHER
  createdAt        DateTime    @default(now())

  // Manual add/subtract correction to this product's "opened" total, on
  // top of the sum of every user's own logged ProductOpening.quantity —
  // for when the admin knows real-world opens happened (or should be
  // removed) that aren't otherwise reflected. Applied in
  // getPacksOpenedGlobal (lib/data/productOpenings.ts), which clamps the
  // resulting total at 0 rather than enforcing a floor here.
  adminOpenedAdjustment Int @default(0)

  cardSet   CardSet           @relation(fields: [cardSetId], references: [id], onDelete: Cascade)
  packKinds ProductPackKind[]
  openings  ProductOpening[]

  @@index([cardSetId])
}

// One "kind" of pack bundled inside a unit of a SetProduct — most products
// only ever need one (e.g. a Hobby Box holding 24 identical packs), but
// some mix different pack types in one box (e.g. 20 base packs of 8 cards
// + 4 bonus packs of 4 cards). packsCount is how many packs of this kind
// come in a single unit of the product; summed across every kind, that's
// the product's total packs-per-unit — see lib/data/productOpenings.ts.
model ProductPackKind {
  id           String @id @default(cuid())
  setProductId String
  packsCount   Int
  cardsPerPack Int
  sortOrder    Int    @default(0)

  setProduct SetProduct @relation(fields: [setProductId], references: [id], onDelete: Cascade)

  @@index([setProductId])
}

// One user's logged "I opened N of this product" count for a set — an
// aggregate quantity, not an individual gel — powering the set page's
// "X Packs/Boxes Opened" total and its per-product breakdown (see
// lib/data/productOpenings.ts). isBreak flags whether this was opened as
// a breaker (vs. for the user's own personal collection), kept as its own
// column — rather than inferred from productType alone — so a future
// "hits pulled by breakers" report can filter on it directly across every
// product type, not just BREAKERS_DELIGHT_BOX.
model ProductOpening {
  id           String   @id @default(cuid())
  userId       String
  cardSetId    String
  setProductId String
  quantity     Int
  isBreak      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardSet    CardSet    @relation(fields: [cardSetId], references: [id], onDelete: Cascade)
  setProduct SetProduct @relation(fields: [setProductId], references: [id], onDelete: Cascade)

  @@unique([userId, setProductId])
  @@index([cardSetId])
}

// ─── PORTFOLIO CARD ──────────────────────────────────────────────────────────

model PortfolioCard {
  id              String  @id @default(cuid())
  userId          String
  checklistCardId String
  cardSetId       String
  ripSessionId    String?

  isHit    Boolean @default(false)
  isInHand Boolean @default(true)

  // ✅ NEW: Pulled or Bought — required by "Your Card" modal path
  acquisitionMethod AcquisitionMethod?

  // Hit context
  hitCountry String?
  hitCity    String?
  hitMonth   Int?
  hitYear    Int?

  // ✅ NEW: Seller field — required by "Your Card" modal path
  seller String? @db.VarChar(255)

  // Who the breaker was — only meaningful when acquisitionMethod is
  // BREAKER. Shown in this gel's card history and its own display card
  // alongside seller, same pattern.
  breakerName String? @db.VarChar(150)

  // The influencer's handle (YouTube channel, Instagram username, etc.) —
  // only meaningful when acquisitionMethod is INFLUENCER. Same required/
  // display pattern as breakerName above.
  influencerHandle String? @db.VarChar(150)

  // Product info
  productType           ProductType?
  productTypeOther      String?      @db.VarChar(150)
  totalCardsInProduct   Int?
  productQuantityOpened Int?

  // Serial number
  serialNumber Int?

  // ✅ UPDATED: split into front and back images (was single cardImageUrl)
  cardFrontImageUrl String?
  cardBackImageUrl  String?

  notes String? @db.Text

  // Every logged gel starts unverified and sits in the developer's /admin/gels
  // review queue — see app/api/admin/gels/[gelId]/verify/route.ts — unless the
  // logging user has already crossed the 5-verified-gels threshold
  // (User.isVerifiedUser), in which case it's auto-verified at creation time.
  isVerified Boolean @default(false)

  // Set when this gel shares a checklistCardId + serialNumber with another
  // PortfolioCard — see DuplicateGelFile below and
  // app/api/sets/[id]/gels/route.ts for how this gets set. Deliberately
  // separate from isVerified: a PENDING gel keeps its own isVerified as-is
  // (just gains a "Possible Duplicate" tag alongside it), and
  // VERIFIED_DUPLICATE overrides the badge shown to the user entirely
  // rather than changing isVerified.
  duplicateFlag DuplicateFlag @default(NONE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  checklistCard           ChecklistCard     @relation(fields: [checklistCardId], references: [id])
  cardSet                 CardSet           @relation(fields: [cardSetId], references: [id])
  ripSession              RipSession?       @relation(fields: [ripSessionId], references: [id])
  // ✅ NEW: chain of custody transfers originating from this portfolio entry
  transfers               CardTransfer[]
  favoritedBy             FavoriteGel[]
  yourGelsPinnedBy        YourGelsPin[]
  duplicateFileAsFiled    DuplicateGelFile? @relation("DuplicateFiledGel")
  duplicateFileAsExisting DuplicateGelFile? @relation("DuplicateExistingGel")
}

enum DuplicateFlag {
  NONE
  PENDING
  VERIFIED_DUPLICATE
  // A DuplicateGelFile with fileType CLAIM is open against this gel —
  // overrides the badge shown to "Verifying" until the admin resolves it.
  CLAIMING
}

// ─── DUPLICATE GEL FILE ───────────────────────────────────────────────────────
// Opened in two cases: a user logs a serialized card (same
// checklistCardId + serialNumber) that someone ELSE has already logged
// (fileType DUPLICATE — the "File a Duplicate" action), or a user logs
// their own copy of a card someone else had only reported seeing
// (fileType CLAIM — the "Claim this Card" action). Both are opened from
// AddGelModal and reviewed by the developer at /admin/duplicate-gels.
model DuplicateGelFile {
  id              String @id @default(cuid())
  // Auto-assigned, starting at 1 — shown to the admin as "Case #N".
  fileNumber      Int    @unique @default(autoincrement())
  checklistCardId String
  filedByUserId   String

  // Nullable + onDelete: SetNull — if the admin later deletes one of the
  // two gels from the file view, the file survives for audit with that
  // slot empty instead of being destroyed.
  filedGelId    String? @unique
  existingGelId String? @unique

  fileType DuplicateFileType @default(DUPLICATE)

  // Pure admin housekeeping — independent of decision below, reopenable.
  status   DuplicateFileStatus   @default(OPEN)
  // The developer's call: for a DUPLICATE file, whether this is a real
  // duplicate (e.g. a genuine manufacturer misprint of the same serial
  // twice) or not (one side made a mistake, handled via the normal
  // edit/verify flow instead); for a CLAIM file, whether the claiming
  // user really does own the card.
  decision DuplicateFileDecision @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  checklistCard ChecklistCard  @relation(fields: [checklistCardId], references: [id])
  filedByUser   User           @relation("DuplicateFiledBy", fields: [filedByUserId], references: [id])
  filedGel      PortfolioCard? @relation("DuplicateFiledGel", fields: [filedGelId], references: [id], onDelete: SetNull)
  existingGel   PortfolioCard? @relation("DuplicateExistingGel", fields: [existingGelId], references: [id], onDelete: SetNull)
  notifications Notification[]
}

enum DuplicateFileType {
  DUPLICATE
  CLAIM
  // Both ends are real owned gels (one Pulled, one Bought) of the same
  // physical card — see "Did you buy/pull this?" in AddGelModal/CardImageModal.
  CO_OWNERSHIP
}

enum DuplicateFileStatus {
  OPEN
  CLOSED
}

enum DuplicateFileDecision {
  PENDING
  CONFIRMED_DUPLICATE
  NOT_DUPLICATE
  CLAIM_APPROVED
  CLAIM_REJECTED
  // CO_OWNERSHIP only — PENDING above covers "filed, existing gel not yet
  // verified, no notification sent."
  CO_OWN_AWAITING_OWNER
  CO_OWN_CONFIRMED
  CO_OWN_DENIED
  CO_OWN_UNSURE
}

// ─── NOTIFICATION ─────────────────────────────────────────────────────────────
// Shown via the bell icon in Navbar.tsx (no dedicated page) — currently
// only used for the CO_OWNERSHIP claim flow: the original gel's owner is
// asked to confirm/deny/defer a co-ownership request once their own gel
// is verified, and the claimer is told if their request is denied.
// Deliberately minimal — no duplicated render fields, everything (the
// claimer, the acquisitionMethod claimed, the card) is read by joining
// through duplicateGelFile at fetch time (see lib/data/notifications.ts),
// same "reuse the rich relation" approach as AdminDuplicateFile.
model Notification {
  id                 String           @id @default(cuid())
  userId             String
  type               NotificationType
  duplicateGelFileId String?
  isRead             Boolean          @default(false)
  createdAt          DateTime         @default(now())

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  duplicateGelFile DuplicateGelFile? @relation(fields: [duplicateGelFileId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

enum NotificationType {
  CO_OWNERSHIP_REQUEST
  CO_OWNERSHIP_DENIED
}

// ─── FAVORITE GEL ─────────────────────────────────────────────────────────────
// A user's hand-picked "Favorite Gels" shown on their profile page (max 6,
// enforced in app/api/profile/favorites/route.ts, not here) — `order`
// drives the display sequence, which the user can rearrange.
model FavoriteGel {
  id              String   @id @default(cuid())
  userId          String
  portfolioCardId String
  order           Int      @default(0)
  createdAt       DateTime @default(now())

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  portfolioCard PortfolioCard @relation(fields: [portfolioCardId], references: [id], onDelete: Cascade)

  @@unique([userId, portfolioCardId])
  @@index([userId, order])
}

// ─── YOUR GELS PIN ──────────────────────────────────────────────────────────
// A user's hand-picked selection of which of THEIR OWN gels in one specific
// set show in that set's "Your Gels" section, once they own more than
// YOUR_GELS_DISPLAY_LIMIT gels there (see lib/data/sets.ts) — same
// pick-and-reorder shape as FavoriteGel above, just scoped to one set
// instead of being global across the whole profile. `order` drives the
// display sequence. cardSetId is redundant with portfolioCard.cardSetId
// (a gel never changes sets) but kept directly on this row so "every pin
// for this user in this set" is a plain indexed lookup, no join needed.
model YourGelsPin {
  id              String   @id @default(cuid())
  userId          String
  cardSetId       String
  portfolioCardId String
  order           Int      @default(0)
  createdAt       DateTime @default(now())

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardSet       CardSet       @relation(fields: [cardSetId], references: [id], onDelete: Cascade)
  portfolioCard PortfolioCard @relation(fields: [portfolioCardId], references: [id], onDelete: Cascade)

  @@unique([userId, portfolioCardId])
  @@index([userId, cardSetId, order])
}

// ─── RIP SESSION ────────────────────────────────────────────────────────────

model RipSession {
  id        String  @id @default(cuid())
  userId    String
  cardSetId String?

  productType      ProductType
  productTypeOther String?     @db.VarChar(150)
  quantity         Int         @default(1)

  totalCardsFromSession Int @default(0)
  totalHitsFromSession  Int @default(0)

  finishedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardSet        CardSet?        @relation(fields: [cardSetId], references: [id])
  portfolioCards PortfolioCard[]
}

// ─── UNVERIFIED HIT ──────────────────────────────────────────────────────────

model UnverifiedHit {
  id              String @id @default(cuid())
  checklistCardId String
  submittedById   String

  // ✅ UPDATED: notes and sightings are now REQUIRED (not optional)
  notes     String @db.Text
  sightings String @db.Text

  // ✅ NEW: optional provenance fields for "Not Your Card" path
  reportedUsername  String?
  sourceUrl         String?
  acquisitionMethod AcquisitionMethod?
  seller            String?            @db.VarChar(255)
  hitCountry        String?
  hitCity           String?
  hitMonth          Int?
  hitYear           Int?
  productType       ProductType?

  // ✅ NEW: optional front/back images for "Not Your Card" path
  cardFrontImageUrl String?
  cardBackImageUrl  String?

  createdAt DateTime @default(now())

  checklistCard ChecklistCard @relation(fields: [checklistCardId], references: [id])
  submittedBy   User          @relation(fields: [submittedById], references: [id])
}

// ─── CARD TRANSFER (Chain of Custody) ────────────────────────────────────────
// ✅ NEW MODEL: tracks the full movement history of a physical card

model CardTransfer {
  id              String @id @default(cuid())
  checklistCardId String
  portfolioCardId String

  // Who sent and who received
  fromUserId String? // null = external/unknown origin
  toUserId   String? // null = sold outside the platform

  // Transfer context
  transferDate   DateTime?
  transferMethod String?   @db.VarChar(100) // e.g. "Sold", "Traded", "Gifted"
  salePrice      Float?
  notes          String?   @db.Text

  createdAt DateTime @default(now())

  checklistCard ChecklistCard @relation(fields: [checklistCardId], references: [id])
  portfolioCard PortfolioCard @relation(fields: [portfolioCardId], references: [id])
  fromUser      User?         @relation("TransferSender", fields: [fromUserId], references: [id])
  toUser        User?         @relation("TransferReceiver", fields: [toUserId], references: [id])
}

// ─── CHECKLIST CARD LIKE ─────────────────────────────────────────────────────

model ChecklistCardLike {
  id              String   @id @default(cuid())
  userId          String
  checklistCardId String
  createdAt       DateTime @default(now())

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  checklistCard ChecklistCard @relation(fields: [checklistCardId], references: [id], onDelete: Cascade)

  @@unique([userId, checklistCardId])
}

// ─── CHECKLIST CARD ──────────────────────────────────────────────────────────
// Represents a single card entry in an official set checklist.
// This is the "master list" of every card that exists in a given CardSet.

model ChecklistCard {
  id        String @id @default(cuid())
  cardSetId String

  cardNumber String
  playerName String // For TCG: card name e.g. "Charizard ex"
  team       String? // Sports/Entertainment only — null for TCG

  // ── The 3-Layer Identity ─────────────────────────────────────────────────
  cardCategory CardCategory // What family: AUTO, PARALLEL, HYPER_RARE, etc.
  cardTier     CardTier // How scarce: NUMBERED, ONE_OF_ONE, SSP, etc.

  // ── Card-Specific Attributes ─────────────────────────────────────────────
  parallel      String? // e.g. "Black", "Gold", "Red", "Orange" — null for base
  printRun      Int? // e.g. 10, 5, 25, 99 — null if unlimited/unspecified
  variationName String? // e.g. "Planetary Pursuit Sun", "Trophy Supercollector"

  // ── Quick-Access Flags ───────────────────────────────────────────────────
  // isChase was removed: every checklist row imported onto this platform is
  // intentionally a chase card already (base cards are excluded from the
  // source checklist before import), so the flag carried no information.
  isHit Boolean @default(false) // AUTO, RELIC, AUTO_RELIC, etc.

  // Admin-set default image for this checklist row, uploaded per card from
  // /admin/sets/[id]/checklist — shown until a real user logs a gel against
  // this card, whose own photo then takes precedence (see
  // lib/data/checklistRowExtras.ts and lib/data/sets.ts for the fallback).
  imageUrl String?

  // Admin-only notes shown in the public checklist's "Notes" column — set
  // from the Edit Checklist Card flow at /admin/sets/[id]/checklist. Not to
  // be confused with PortfolioCard.notes (a user's own note about their
  // logged gel, which only ever appears in that gel's own Card History).
  notes String? @db.Text

  // Position of this card in the original checklist file (0 = first row).
  // The checklist page always displays cards ordered by this field, so it
  // matches the sequence the set's source file was published in, rather
  // than an alphabetical re-sort. Set at import time — see
  // prisma/import-checklist.ts.
  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cardSet        CardSet             @relation(fields: [cardSetId], references: [id], onDelete: Cascade)
  portfolioCards PortfolioCard[]
  likes          ChecklistCardLike[]
  transfers      CardTransfer[]
  unverifiedHits UnverifiedHit[]
  duplicateFiles DuplicateGelFile[]

  // variationName is part of the uniqueness key (not just cardNumber+
  // parallel) so two genuinely different inserts can legitimately share
  // the same parallel name under the same cardNumber — e.g. a "Gold
  // Rainbow /50" base-card parallel and a "Gold Rainbow /50" autograph
  // insert parallel for the same player are different physical cards,
  // told apart by variationName both here and in the checklist UI (see
  // playerSubtitle in ChecklistTable.tsx, which already shows
  // variationName alongside parallel whenever both are set).
  @@unique([cardSetId, cardNumber, parallel, variationName])
  @@index([cardSetId, sortOrder])
}

// ─── RATE LIMITING ──────────────────────────────────────────────────────────
// Fixed-window request counter for proxy.ts's basic abuse protection on
// mutation routes (gel creation, likes, admin actions, etc). One row per
// key (currently just a client IP); `count` resets whenever a request
// lands outside the current window instead of needing a cron job to prune
// old windows. The table itself can still grow by one row per distinct IP
// ever seen — proxy.ts opportunistically deletes rows well outside the
// window on a small fraction of requests to keep this bounded.
model RateLimitCounter {
  key         String   @id
  windowStart DateTime
  count       Int      @default(1)

  @@index([windowStart])
}

// ─── ABOUT US PAGE ──────────────────────────────────────────────────────────
// Admin-editable header+copy blocks rendered in order on app/about/page.tsx
// (see components/admin/AdminAboutClient.tsx for the editor). The page's
// title and closing "Rip. Gel. Repeat." tagline are fixed in the page
// template, not stored here — only the middle Q&A-style content is dynamic.
model AboutUsSection {
  id        String   @id @default(cuid())
  heading   String?
  body      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}
